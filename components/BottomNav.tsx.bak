"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import { LayoutDashboard, List, Settings } from "lucide-react";

const NAV = [
  { href: "/dashboard", label: "Dashboard", Icon: LayoutDashboard },
  { href: "/entries", label: "Entries", Icon: List },
  { href: "/settings", label: "Settings", Icon: Settings },
];

interface BottomNavProps {
  onAdd: () => void;
}

export default function BottomNav({ onAdd }: BottomNavProps) {
  const pathname = usePathname();

  return (
    <nav
      style={{
        position: "fixed",
        bottom: 0,
        left: 0,
        right: 0,
        height: "72px",
        background: "#fff",
        borderTop: "1.5px solid var(--smoke)",
        display: "flex",
        alignItems: "center",
        justifyContent: "space-around",
        padding: "0 1rem",
        zIndex: 50,
      }}
    >
      {NAV.map(({ href, label, Icon }, i) => {
        const active = pathname.startsWith(href);
        // Insert the FAB between entries (i=1) and settings (i=2)
        const fab = i === 2 ? (
          <button
            key="fab"
            onClick={onAdd}
            aria-label="Add entry"
            style={{
              width: "56px",
              height: "56px",
              borderRadius: "50%",
              background: "var(--mango)",
              color: "#fff",
              border: "none",
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              boxShadow: "0 4px 18px rgba(255,138,61,0.45)",
              fontSize: "1.75rem",
              lineHeight: 1,
              transition: "transform 0.15s, box-shadow 0.15s",
              marginBottom: "4px",
            }}
            onMouseOver={(e) => {
              (e.currentTarget as HTMLButtonElement).style.transform = "scale(1.08)";
            }}
            onMouseOut={(e) => {
              (e.currentTarget as HTMLButtonElement).style.transform = "scale(1)";
            }}
          >
            +
          </button>
        ) : null;

        return [
          fab,
          <Link
            key={href}
            href={href}
            style={{
              display: "flex",
              flexDirection: "column",
              alignItems: "center",
              gap: "2px",
              color: active ? "var(--mango)" : "var(--muted)",
              textDecoration: "none",
              fontSize: "0.65rem",
              fontWeight: active ? 600 : 400,
              transition: "color 0.15s",
              minWidth: "52px",
            }}
          >
            <Icon size={22} strokeWidth={active ? 2.2 : 1.8} />
            {label}
          </Link>,
        ];
      })}
    </nav>
  );
}
