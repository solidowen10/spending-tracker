import Link from "next/link";

interface TopBarProps {
  title: string;
  backHref?: string;
}

export default function TopBar({ title, backHref }: TopBarProps) {
  return (
    <header
      style={{
        position: "fixed",
        top: 0,
        left: 0,
        right: 0,
        height: "56px",
        background: "var(--cream)",
        borderBottom: "1.5px solid var(--smoke)",
        display: "flex",
        alignItems: "center",
        padding: "0 1rem",
        zIndex: 40,
        gap: "0.75rem",
      }}
    >
      {backHref && (
        <Link
          href={backHref}
          style={{ color: "var(--mango)", textDecoration: "none", fontSize: "1.25rem", lineHeight: 1 }}
        >
          ←
        </Link>
      )}
      <h1
        style={{
          fontFamily: "var(--font-fredoka)",
          fontSize: "1.35rem",
          fontWeight: 600,
          color: "var(--plum)",
          margin: 0,
        }}
      >
        {title}
      </h1>
    </header>
  );
}
