@import "tailwindcss";

/* ─── lürú brand palette ─────────────────────────────────────────────────── */
:root {
  --cream:   #FFF8F0;   /* page background */
  --mango:   #FF8A3D;   /* primary / brand accent */
  --grape:   #7C5CFC;   /* secondary accent */
  --lime:    #4ECB71;   /* success / under-budget */
  --lemon:   #FFC93C;   /* warning / near-limit */
  --cherry:  #FF5C72;   /* danger / over-limit */
  --plum:    #2B1B3D;   /* headings / dark text */
  --smoke:   #F1EBE4;   /* card / input backgrounds */
  --muted:   #9B8BAB;   /* secondary text */
}

@theme inline {
  --font-display: var(--font-fredoka);
  --font-body:    var(--font-jakarta);

  --color-cream:  var(--cream);
  --color-mango:  var(--mango);
  --color-grape:  var(--grape);
  --color-lime:   var(--lime);
  --color-lemon:  var(--lemon);
  --color-cherry: var(--cherry);
  --color-plum:   var(--plum);
  --color-smoke:  var(--smoke);
  --color-muted:  var(--muted);
}

/* ─── Base ───────────────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; }

html, body {
  min-height: 100%;
  background: var(--cream);
  color: var(--plum);
  font-family: var(--font-body), system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ─── Scrollbar ──────────────────────────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--smoke); border-radius: 99px; }
